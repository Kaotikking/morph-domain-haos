{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kaotikking/morph-domain-haos/schemas/founder-package-v1.schema.json",
  "title": "Serein Morph Founder Package v1",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "kind",
    "compatibility",
    "payload",
    "fallback",
    "fixtures",
    "content_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "serein.morph-package.v1"
    },
    "package_id": {
      "pattern": "^PKG-FOUNDER-[A-Z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "FOUNDER"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "engine_major"
      ],
      "properties": {
        "engine_major": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "element_id",
        "founder_id",
        "public_lineage_id",
        "starter_id",
        "name",
        "primary",
        "recessive",
        "signature",
        "word_pools",
        "palette",
        "catalysts"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "founder_id": {
          "type": "string",
          "pattern": "^F-[0-9]{2}$"
        },
        "public_lineage_id": {
          "type": "string",
          "pattern": "^E-[0-9]{2}$"
        },
        "starter_id": {
          "type": "string",
          "pattern": "^L1-[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "recessive": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "word_pools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "palette": {
          "type": "string",
          "minLength": 1
        },
        "catalysts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}


