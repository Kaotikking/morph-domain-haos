{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kaotikking/morph-domain-haos/schemas/presentation-package-v1.schema.json",
  "title": "Serein Morph Presentation Package v1",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "kind",
    "compatibility",
    "payload",
    "fallback",
    "fixtures"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "serein.morph-package.v1"
    },
    "package_id": {
      "pattern": "^PKG-PRESENTATION-[A-Z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "PRESENTATION"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "engine_major"
      ],
      "properties": {
        "engine_major": {
          "const": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "presentation_id",
        "forms",
        "capability_tiers",
        "silhouette",
        "palette",
        "effects",
        "animations",
        "voice",
        "localization",
        "accessibility",
        "frame_profiles"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1
    }
  }
}


