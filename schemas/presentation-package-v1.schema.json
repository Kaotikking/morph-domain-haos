{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kaotikking/morph-domain-haos/schemas/presentation-package-v1.schema.json",
  "title": "Serein Morph Presentation Package v1",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "kind",
    "compatibility",
    "payload",
    "fallback",
    "fixtures",
    "content_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "serein.morph-package.v1"
    },
    "package_id": {
      "pattern": "^PKG-PRESENTATION-[A-Z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "PRESENTATION"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "engine_major"
      ],
      "properties": {
        "engine_major": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "presentation_id",
        "forms",
        "capability_tiers",
        "silhouette",
        "palette",
        "effects",
        "animations",
        "voice",
        "localization",
        "accessibility",
        "frame_profiles"
      ],
      "properties": {
        "presentation_id": {
          "type": "string",
          "minLength": 1
        },
        "forms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capability_tiers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "uniqueItems": true
        },
        "silhouette": {
          "type": "string",
          "minLength": 1
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "voice": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "localization": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "accessibility": {
          "type": "object"
        },
        "frame_profiles": {
          "type": "object",
          "required": [
            "SERN-LOW"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}


