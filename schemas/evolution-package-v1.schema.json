{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kaotikking/morph-domain-haos/schemas/evolution-package-v1.schema.json",
  "title": "Serein Morph Evolution Package v1",
  "type": "object",
  "required": [
    "schema",
    "package_id",
    "kind",
    "compatibility",
    "payload",
    "fallback",
    "fixtures",
    "content_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "serein.morph-package.v1"
    },
    "package_id": {
      "pattern": "^PKG-EVOLUTION-[A-Z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "EVOLUTION"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "engine_major"
      ],
      "properties": {
        "engine_major": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "form_id",
        "class",
        "lineages",
        "evidence",
        "catalysts",
        "capabilities",
        "stability",
        "reversion",
        "presentation_id",
        "exclusions"
      ],
      "properties": {
        "form_id": {
          "type": "string",
          "pattern": "^FORM-[0-9]{2}(?:\\.[0-9]{2})?-[A-Z0-9_.-]+$"
        },
        "class": {
          "enum": [
            "NATURAL",
            "CONTEXT",
            "RESONANCE",
            "CULMINATION"
          ]
        },
        "lineages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "catalysts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "stability": {
          "type": "string",
          "minLength": 1
        },
        "reversion": {
          "enum": [
            "RESTING_FORM",
            "CONTEXT_END",
            "ENERGY_FLOOR",
            "STABLE"
          ]
        },
        "presentation_id": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}


